{
  "description": "Same git/gh guard as .claude/settings.json. Trust a new or changed hook with /hooks before it runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/claude-bash-guard.ts\"",
            "timeout": 10,
            "statusMessage": "Checking git and gh commands"
          }
        ]
      }
    ]
  }
}
