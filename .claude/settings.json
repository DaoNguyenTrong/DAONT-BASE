{
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)"
    ]
  },
  "enabledPlugins": {
    "release-kit@daont-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "daont-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "DaoNguyenTrong/daont-claude-plugins"
      },
      "autoUpdate": true
    }
  }
}
