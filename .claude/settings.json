{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/scripts/claude-bash-guard.ts",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "release-kit@daont-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "daont-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "DaoNguyenTrong/daont-claude-plugins"
      },
      "autoUpdate": true
    }
  }
}
