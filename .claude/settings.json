{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-task-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "release-kit@daont-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "daont-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "DaoNguyenTrong/daont-claude-plugins"
      },
      "autoUpdate": true
    }
  }
}
