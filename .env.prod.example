# Variables consumed by docker-compose.prod.yml itself (not the app). Application-level secrets
# (JWT key, SMTP, connection string, ...) live in backend/src/StarterKit.API/appsettings.json
# instead (gitignored, bind-mounted into the api container) — see README "Production (Docker)".
#
# cp .env.prod.example .env.prod, then fill in real values. .env.prod is gitignored.

POSTGRES_USER=starterkit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=StarterKit_api

# Baked into the frontend bundle at build time. Leave empty (default) so the app calls the API
# via same-origin relative paths (/api/...), proxied by nginx — no CORS, no domain to know upfront.
VITE_API_BASE_URL=

# Frontend runtime config — NOT baked into the image: the web container writes these into
# /config.json at startup, so a change only needs `docker compose ... up -d`. All values are public
# client-side identifiers (no secrets). Leave a value empty to disable that feature — the matching
# backend setting in appsettings.json must be filled for it to work end to end.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
# Empty = "common" (work/school + personal accounts); must match the backend's TenantId.
VITE_MICROSOFT_TENANT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# User guide at /guide/. Empty or false (default): only signed-in users can read it — nginx asks the
# API for each request, which needs the API on the same origin as the app (VITE_API_BASE_URL empty).
# A reader whose 15-minute access cookie has expired passes through the app once and comes back to
# the same page. true: anyone can read it (also the choice when the API is on another origin).
GUIDE_PUBLIC=
