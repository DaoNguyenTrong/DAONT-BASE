VITE_API_BASE_URL=http://localhost:7000
BASE_URL=/
# Optional — Google OAuth Client ID (Web application type). Leave empty to hide
# the "Continue with Google" button entirely; matches the backend's own
# ExternalAuthSettings:Google:ClientId being optional (no fail-fast).
VITE_GOOGLE_CLIENT_ID=
# Optional — Microsoft Entra ID (Azure AD) application (client) ID. Leave empty to
# hide the "Continue with Microsoft" button entirely; matches the backend's own
# ExternalAuthSettings:Microsoft:ClientId being optional (no fail-fast).
VITE_MICROSOFT_CLIENT_ID=
# Tenant to authenticate against — "common" allows both work/school and personal
# Microsoft accounts; must match the backend's ExternalAuthSettings:Microsoft:TenantId.
VITE_MICROSOFT_TENANT_ID=common
