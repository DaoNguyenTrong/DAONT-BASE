# Copy to .env.e2e and fill in real values. .env.e2e is gitignored — never commit it.
# See your backend's account provisioning docs for how to obtain these.

# Where Playwright drives the browser. Must include the trailing slash and
# match BASE_URL in .env.production / vite.config.ts.
# Default assumes `vite preview --port 4173` (see playwright.config.ts webServer).
E2E_BASE_URL=http://localhost:4173/

# Admin account (role: Admin) — used by auth.spec.ts's admin-redirect case.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Plain user account (role: User) — used by auth.spec.ts, guards.spec.ts,
# profile-sessions.spec.ts, logout.spec.ts.
E2E_USER_USERNAME=
E2E_USER_PASSWORD=
