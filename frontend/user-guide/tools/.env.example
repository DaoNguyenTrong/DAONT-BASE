# Copy to .env (gitignored) for `bun run --cwd frontend guide:capture`. See frontend/user-guide/README.md.

# The running app and its API.
GUIDE_BASE_URL=http://localhost:5175
GUIDE_API_URL=http://localhost:7100

# The account whose screens are photographed (an owner of an organization — see the README for the
# data it needs). Used only when the saved session in .auth/ no longer works.
GUIDE_USERNAME=
GUIDE_PASSWORD=

# vi, en or all (default).
GUIDE_LOCALE=all
