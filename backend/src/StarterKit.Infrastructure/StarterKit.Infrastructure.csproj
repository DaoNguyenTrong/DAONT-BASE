<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StarterKit.Domain\StarterKit.Domain.csproj" />
    <ProjectReference Include="..\StarterKit.Application\StarterKit.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StarterKit.Infrastructure.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- API.Tests builds the real PasswordHasher at a test work factor (internal ctor). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StarterKit.API.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- NSubstitute mocks internal interfaces via Castle DynamicProxy, which emits its own
         dynamic assembly and needs its own InternalsVisibleTo grant to see internal types. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Security pins for vulnerable TRANSITIVE packages (found by `dotnet list package` with the vulnerable + include-transitive options):
      System.Security.Cryptography.Pkcs  ← MimeKit (via MailKit) resolves 10.0.0   — GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7
      System.Security.Cryptography.Xml   ← Microsoft.AspNetCore.DataProtection 10.0.10 — GHSA-r955-8q5j-3h83 et al.
      MessagePack                        ← Microsoft.AspNetCore.SignalR.StackExchangeRedis 10.0.10 — GHSA-qhrr-8q5h-9q3h
    Remove each pin once its parent package ships a dependency at or above the patched version.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Pruned for this project (the ASP.NET shared framework supplies it), hence NU1510 — but the
         test projects resolve the package version transitively, so the pin must stay. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" NoWarn="NU1510" />
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>
